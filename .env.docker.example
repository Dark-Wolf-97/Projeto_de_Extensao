# Copie este arquivo para .env e preencha com suas credenciais reais
# cp .env.docker.example .env

DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=clinica_db

JWT_SECRET=troque_por_uma_chave_secreta_forte
JWT_EXPIRES_IN=1d

# Opcional quando o backend também for acessado fora do proxy de mesma origem.
# Separe múltiplas origens por vírgula. Exemplo: http://192.168.1.10
CORS_ORIGIN=

# Preencha somente para executar o seed dos usuários iniciais (ADMIN, SECRETARIA,
# MEDICO). Cada perfil é opcional e independente: se as variáveis de um perfil
# ficarem todas em branco, aquele usuário simplesmente não é criado.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SECRETARIA_NOME=
SECRETARIA_EMAIL=
SECRETARIA_PASSWORD=
SECRETARIA_TELEFONE=

MEDICO_NOME=
MEDICO_EMAIL=
MEDICO_PASSWORD=
MEDICO_CRM=
MEDICO_ESPECIALIDADE=
MEDICO_TELEFONE=

# Google Agenda. A chave privada pode usar quebras de linha escapadas como \n.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=30

# WhatsApp (whatsapp-web.js). A sessão fica no volume whatsapp_session
# (LocalAuth) — trate como credencial, nunca a exponha nem versione.
# Padrão é habilitado (conecta sozinho no boot se já houver sessão salva).
# Defina como false para não conectar automaticamente ao subir o container
# — mesmo assim o botão "Conectar" em Configurações continua funcionando.
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=/app/whatsapp-session
WHATSAPP_CONFIRMACAO_DELAY_MINUTES=3
