# Copie este arquivo para .env e preencha com seus dados locais

DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/clinica_db"
PORT=3000
JWT_SECRET="sua_chave_secreta_aqui"
JWT_EXPIRES_IN="1d"

# Preencha somente para rodar "npm run seed" (cria os usuários iniciais).
# Cada perfil é opcional e independente: se as três variáveis de um perfil
# ficarem em branco, aquele usuário simplesmente não é criado.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SECRETARIA_NOME=
SECRETARIA_EMAIL=
SECRETARIA_PASSWORD=
SECRETARIA_TELEFONE=

MEDICO_NOME=
MEDICO_EMAIL=
MEDICO_PASSWORD=
MEDICO_CRM=
MEDICO_ESPECIALIDADE=
MEDICO_TELEFONE=

# Google Agenda (não use caminho para chave JSON e nunca versione a chave real)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=30

# WhatsApp (whatsapp-web.js). A sessão fica salva em WHATSAPP_SESSION_PATH
# (LocalAuth) — trate essa pasta como credencial, nunca a versione.
# Padrão é habilitado (conecta sozinho no boot se já houver sessão salva).
# Defina como false para não conectar automaticamente ao subir o processo
# — mesmo assim o botão "Conectar" em Configurações continua funcionando.
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_CONFIRMACAO_DELAY_MINUTES=3
