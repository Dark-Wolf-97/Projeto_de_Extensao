# Copie este arquivo para .env e preencha com seus dados locais

DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/clinica_db"
PORT=3000
JWT_SECRET="sua_chave_secreta_aqui"
JWT_EXPIRES_IN="1d"

# Preencha somente para rodar "npm run seed" (cria os usuários iniciais).
# Cada perfil é opcional e independente: se as três variáveis de um perfil
# ficarem em branco, aquele usuário simplesmente não é criado.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SECRETARIA_NOME=
SECRETARIA_EMAIL=
SECRETARIA_PASSWORD=
SECRETARIA_TELEFONE=

MEDICO_NOME=
MEDICO_EMAIL=
MEDICO_PASSWORD=
MEDICO_CRM=
MEDICO_ESPECIALIDADE=
MEDICO_TELEFONE=
